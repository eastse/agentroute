# Add semicolons at the end of statements
semi: true
# Number of spaces per indentation level
tabWidth: 4
# Use spaces instead of tabs for indentation
useTabs: false
# Line ending style, lf = \n (Unix), crlf = \r\n (Windows)
endOfLine: lf
# Maximum characters per line before wrapping
printWidth: 100
# Use single quotes for strings
singleQuote: false
# Trailing commas: es5 = add where valid in ES5 (objects, arrays, etc.), all = include function parameters
trailingComma: es5
# Put each JSX attribute on its own line
singleAttributePerLine: true
# Preserve spaces inside object literal braces, such as { foo: bar }
bracketSpacing: true
# Always include parentheses around arrow function parameters, such as (x) => x
arrowParens: always
# Keep the JSX closing > on the same line (false = wrap, matching React community conventions)
bracketSameLine: false
# Use double quotes in JSX, matching HTML attribute conventions
jsxSingleQuote: false

# Plugin list; prettier-plugin-tailwindcss automatically sorts Tailwind CSS class names
plugins: [ "prettier-plugin-tailwindcss" ]
# Plugin configuration for prettier-plugin-tailwindcss class sorting
tailwindStylesheet: "src/app/global.css"
# Tailwind CSS class name helper functions recognized and sorted by prettier-plugin-tailwindcss
tailwindFunctions: [ "cn", "cva" ]
