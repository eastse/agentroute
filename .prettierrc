# 语句末尾添加分号
semi: true
# 缩进空格数
tabWidth: 4
# 换行符风格，lf = \n（Unix），crlf = \r\n（Windows）
endOfLine: lf
# 每行最大字符数，超出则换行
printWidth: 100
# 字符串使用单引号
singleQuote: false
# 尾随逗号：es5 = 在 ES5 合法的地方添加（对象、数组等），all = 函数参数也加
trailingComma: es5
# JSX 每个属性独占一行
singleAttributePerLine: true
# 对象字面量括号内保留空格，如 { foo: bar }
bracketSpacing: true
# 箭头函数参数始终加括号，如 (x) => x
arrowParens: always
# JSX 闭合 > 不换行到下一行（false = 换行，符合 React 社区习惯）
bracketSameLine: false
# JSX 中使用双引号（与 HTML 属性习惯一致）
jsxSingleQuote: false

# 插件列表，prettier-plugin-tailwindcss 用于自动排序 Tailwind CSS 类名
plugins: [ "prettier-plugin-tailwindcss" ]
# 插件配置，使用 prettier-plugin-tailwindcss 来自动排序 Tailwind CSS 类名
tailwindStylesheet: "app/app.css"
# 指定 Tailwind CSS 类名函数，prettier-plugin-tailwindcss 将识别这些函数中的类名并进行排序
tailwindFunctions: [ "cn", "cva" ]
