{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.sh\"",
            "timeout": 10,
            "statusMessage": "Loading AgentRoute Codex guidance"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_reminder.sh\"",
            "timeout": 10,
            "statusMessage": "Checking AgentRoute validation reminders"
          }
        ]
      }
    ]
  }
}
